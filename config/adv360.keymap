/ {
	behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO
      macro_ver: macro_ver {
        compatible = "zmk,behavior-macro";
        label = "macro_version";
        #binding-cells = <0>;
        bindings = <&kp RET>;
      };
      #endif

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };
    };

  base {
    compatible = "zmk,keymap";
    base {
	    bindings=<&none	&kp N1	&kp N2	&kp N3	&kp N4	&kp N5	&tog game					&tog bluetooth	&kp N6	&kp N7	&kp N8	&kp N9	&kp N0	&none
&none	&kp Q	&kp W	&kp E	&kp R	&kp T	&kp C_BRIGHTNESS_INC					&kp C_VOL_UP	&kp Y	&kp U	&kp I	&kp O	&none	&none
&kp CAPS	&kp A	&kp S	&lt lower D	&lt raise F	&kp G	&kp C_BRIGHTNESS_DEC	&kp LEFT_COMMAND	&none	&none	&kp RIGHT_COMMAND	&kp C_VOL_DN	&kp H	&lt raise J	&kp K	&kp L	&kp P	&kp FSLH
&kp LCTRL	&kp Z	&kp X	&kp C	&kp V	&kp B			&none	&none			&kp N	&lt apper M	&kp COMMA	&mt LEFT_COMMAND DOT	&kp FSLH	&kp LCTRL
&mo functions	&kp C_PLAY_PAUSE	&none	&none	&none		&mt LSHIFT SPACE	&mt LALT ESC	&none	&none	&kp ENTER	&kp BSPC		&kp TAB	&none	&none	&none	&mo functions>; };
    lower {bindings=<&none	&none	&none	&none	&none	&none	&none					&none	&none	&none	&none	&none	&none	&none
&none	&none	&WezSwitchWS	&none	&none	&none	&none					&none	&none	&none	&VimSaveClose	&none	&none	&none
&none	&CaretMoveToHome	&kp LEFT	&none	&kp RIGHT	&none	&none	&OsSearch	&none	&none	&kp RIGHT_COMMAND	&none	&none	&kp DOWN	&VimSave	&kp UP	&CaretMoveToEnd	&none
&kp LCTRL	&none	&WezSwitchPaneLeft	&none	&WezSwitchPaneRight	&none			&none	&none			&none	&none	&VimClose	&kp LEFT_COMMAND	&none	&kp LCTRL
&none	&none	&none	&none	&none		&trans	&kp LALT	&none	&none	&kp ENTER	&kp DEL		&none	&none	&none	&none	&none>;
