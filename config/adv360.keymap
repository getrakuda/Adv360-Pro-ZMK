/ {
	behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO
      macro_ver: macro_ver {
        compatible = "zmk,behavior-macro";
        label = "macro_version";
        #binding-cells = <0>;
        bindings = <&kp RET>;
      };
      #endif

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };
    };

  base {
    compatible = "zmk,keymap";
    base {
	    bindings=<&none	&kp N1	&kp N2	&kp N3	&kp N4	&kp N5	&tog game					&tog bluetooth	&kp N6	&kp N7	&kp N8	&kp N9	&kp N0	&none
&ShowAllBootedApps	&kp Q	&kp W	&kp E	&kp R	&kp T	&kp C_BRIGHTNESS_INC					&kp C_VOL_UP	&kp Y	&kp U	&kp I	&kp O	&mo wezWsSwitchLayer	&none
&kp CAPS	&kp A	&kp S	&lt lower D	&lt raise F	&kp G	&kp C_BRIGHTNESS_DEC	&kp LCTRL	&kp LEFT_COMMAND	&kp RIGHT_COMMAND	&kp LCTRL	&kp C_VOL_DN	&kp H	&lt raise J	&kp K	&kp L	&kp P	&kp FSLH
&kp LSHIFT	&kp Z	&kp X	&kp C	&kp V	&kp B			&none	&none			&kp N	&lt apper M	&kp COMMA	&mt LEFT_COMMAND DOT	&kp FSLH	&kp LSHIFT
&mo functions	&kp C_PLAY_PAUSE	&none	&none	&none		&kp SPACE	&mt LALT ESC	&none	&none	&kp ENTER	&kp BSPC		&kp TAB	&none	&none	&none	&mo functions>; };
    lower {bindings=<&none	&none	&none	&none	&none	&none	&none					&none	&none	&none	&none	&none	&none	&none
&none	&none	&none	&none	&none	&none	&none					&none	&none	&WezSwitchPaneLeft	&VimSaveClose	&WezSwitchPaneRight	&none	&none
&none	&CaretMoveToHome	&kp LEFT	&none	&kp RIGHT	&none	&none	&trans	&trans	&trans	&trans	&none	&none	&kp DOWN	&VimSave	&kp UP	&CaretMoveToEnd	&none
&trans	&none	&none	&none	&none	&none			&none	&none			&none	&none	&VimClose	&kp LEFT_COMMAND	&none	&trans
&none	&none	&none	&none	&none		&trans	&kp LALT	&none	&none	&kp ENTER	&kp DEL		&none	&none	&none	&none	&none>;
    };
    raise {bindings=<&none	&none	&none	&none	&none	&none	&none					&none	&none	&none	&none	&none	&none	&none
&none	&kp TILDE	&kp UNDERSCORE	&kp MINUS	&kp PLUS	&kp AMPERSAND	&none					&none	&kp PIPE	&ArrowBracketsStart	&kp FSLH	&ArrowBracketsEnd	&kp BSLH	&none
&kp GRAVE	&kp EXCLAMATION	&kp AT_SIGN	&kp HASH	&kp DOUBLE_QUOTES	&kp COLON	&none	&kp LEFT_COMMAND	&none	&none	&kp RIGHT_COMMAND	&none	&kp SEMICOLON	&kp LEFT_PARENTHESIS	&kp ASTERISK	&kp RIGHT_PARENTHESIS	&kp EQUAL	&none
&none	&kp CARET	&none	&none	&kp SINGLE_QUOTE	&kp DLLR			&none	&none			&kp PRCNT	&kp LBKT	&none	&kp RBKT	&none	&none
&none	&none	&none	&none	&none		&mt LSHIFT SPACE	&mt ESC LALT	&none	&none	&kp ENTER	&kp BSPC		&none	&none	&none	&none	&none>;
    };
    game {
	    bindings=<&none	&kp ESC	&kp N1	&kp N2	&kp N3	&kp N4	&none					&none	&none	&none	&none	&none	&none	&none
&none	&kp TAB	&kp Q	&kp W	&kp E	&kp R	&kp Y					&none	&none	&none	&none	&none	&none	&none
&kp T	&kp LSHIFT	&kp A	&kp S	&kp D	&kp F	&kp G	&kp B	&none	&none	&none	&none	&none	&none	&none	&none	&none	&none
&kp LALT	&kp LCTRL	&kp Z	&kp X	&kp C	&kp V			&none	&none			&none	&kp M	&kp COMMA	&kp DOT	&kp FSLH	&none
&none	&ShadowPlaySS	&ShadowPlayIR	&kp P	&kp N5		&kp SPACE	&mo gameLower	&tog game	&none	&kp ENTER	&kp BSPC		&none	&none	&none	&none	&none>;
    };
    gameLower {bindings=<&none	&none	&kp F1	&kp F2	&kp F3	&kp F4	&none					&none	&none	&none	&none	&none	&none	&none
&none	&kp N6	&kp N7	&kp N8	&kp N9	&kp N0	&none					&none	&none	&none	&none	&none	&none	&none
&none	&PubgCarSeet1	&PubgCarSeet2	&PubgCarSeet3	&PubgCarSeet4	&kp F5	&none	&none	&none	&none	&none	&none	&none	&none	&none	&none	&none	&none
&kp N	&kp H	&kp J	&kp K	&kp L	&none			&none	&none			&none	&none	&none	&none	&none	&none
&none	&none	&none	&none	&none		&none	&none	&none	&none	&none	&none		&none	&none	&none	&none	&none>;
    };
    apper {
	    bindings=<&none	&none	&none	&none	&none	&none	&none					&none	&none	&none	&none	&none	&none	&none
&none	&AppSwitch_8	&CurrentLeft	&none	&CurrentRight	&none	&none					&none	&none	&none	&none	&none	&none	&none
&AppSwitch_8	&AppSwitch_1	&AppSwitch_2	&AppSwitch_3	&AppSwitch_4	&AppSwitch_5	&none	&none	&none	&none	&none	&none	&none	&none	&CurrentFullScr	&CurrentMidScr	&CurrentMinScr	&none
&none	&none	&CurrentOtherHide	&none	&AppSwitch_7	&AppSwitch_6			&none	&none			&none	&none	&WebDevModeMid	&WebDevModeMin	&none	&none
&none	&none	&none	&none	&none		&none	&none	&none	&none	&none	&none		&none	&none	&none	&none	&none>;
    };
    functions {
	    bindings=<&none	&kp F1	&kp F2	&kp F3	&kp F4	&kp F5	&none					&none	&kp F6	&kp F7	&kp F8	&kp F9	&kp F10	&kp F11
&none	&none	&none	&none	&none	&none	&none					&none	&none	&none	&none	&none	&none	&kp F12
&none	&none	&none	&none	&none	&none	&none	&none	&none	&none	&none	&none	&none	&none	&none	&none	&none	&none
&none	&none	&none	&none	&none	&none			&none	&none			&none	&none	&none	&none	&none	&none
&none	&none	&none	&none	&none		&none	&none	&none	&none	&none	&none		&none	&none	&none	&none	&none>;
    };
    bluetooth {
	    bindings=<&none	&none	&none	&none	&none	&none	&none					&tog bluetooth	&none	&none	&none	&none	&none	&none
&none	&none	&none	&none	&none	&none	&none					&none	&none	&none	&none	&none	&none	&none
&none	&none	&bt BT_PRV	&none	&bt BT_NXT	&none	&none	&none	&none	&none	&none	&none	&kp N6	&kp N7	&kp N8	&kp N9	&kp N0	&none
&none	&none	&bt BT_CLR	&bt BT_CLR_ALL	&bootloader	&none			&none	&none			&none	&none	&none	&none	&none	&none
&none	&none	&none	&none	&none		&none	&none	&none	&none	&none	&none		&none	&none	&none	&none	&none>;
    };

wezWsSwitchLayer{bindings=<
	&none	&none	&none	&none	&none	&none	&none					&none	&none	&none	&none	&none	&none	&none
&none	&none	&none	&none	&none	&none	&none					&none	&none	&none	&none	&none	&none	&none
&none	&WezWs1	&WezWs2	&WezWs3	&WezWs4	&WezWs5	&none	&none	&none	&none	&none	&none	&none	&none	&none	&none	&none	&none
&none	&none	&none	&none	&none	&none			&none	&none			&none	&none	&none	&none	&none	&none
&none	&none	&none	&none	&none		&none	&none	&none	&none	&none	&none		&none	&none	&none	&none	&none
>;};


  };
};
