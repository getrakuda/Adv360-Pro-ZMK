/ {
  macros {
	VimPrevSearchLeftArrow: VimPrevSearchLeftArrow {
		compatible = "zmk,behavior-macro";
		#binding-cells = < 0>;
		bindings = <&macro_tap &kp QUESTION &kp LESS_THAN &kp ENTER>;
	};
	VimPrevSearchRightArrow: VimPrevSearchRightArrow {
		compatible = "zmk,behavior-macro";
		#binding-cells = < 0>;
